# =====================================================================
# CONFIGURACIÓN KICK OAUTH 2.0 & SUPABASE
# =====================================================================

# 1. Credenciales de la Aplicación de Kick (https://kick.com/settings/developer)
KICK_CLIENT_ID=tu_kick_client_id_aqui
KICK_CLIENT_SECRET=tu_kick_client_secret_aqui
KICK_REDIRECT_URI=http://localhost:8000/api/auth/kick/callback
KICK_WEBHOOK_SECRET=tu_kick_webhook_secret_aqui

# Nombre de tu canal de Kick
KICK_CHANNEL_SLUG=CaozLive

# 2. Credenciales de tu Proyecto en Supabase (https://supabase.com/dashboard/project/_/settings/api)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_supabase_anon_o_service_role_key_aqui

# 3. Seguridad de Sesión
SESSION_SECRET_KEY=clave_secreta_super_segura_para_cookies_sorteo_kick_ps5
